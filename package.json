{
    "name": "open-hyper-ai",
    "version": "0.0.1",
    "repository": "https://github.com/forest0xia/dota2bot-OpenHyperAI",
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "@types/cheerio": "^0.22.35",
        "@types/node": "^22.10.3",
        "lua-types": "^2.13.1",
        "luaparse": "^0.3.1",
        "prettier": "^3.3.3",
        "typescript": "^5.5.4",
        "typescript-to-lua": "^1.26.2"
    },
    "scripts": {
        "build:lua": "node ./typescript/post-process/build-lua.js",
        "build:node": "tsc -p tsconfig-node.json",
        "build": "npm run build:lua",
        "check": "node ./typescript/post-process/check.js",
        "diagnose": "node ./typescript/post-process/diagnose.js",
        "dev": "tstl -p tsconfig-tstl.json --watch",
        "prettier": "prettier ./bots ./typescript --write",
        "phase0": "node ./typescript/post-process/phase0-report.js",
        "report": "node ./typescript/post-process/phase0-report.js",
        "match": "node ./typescript/post-process/match-setup.js",
        "decisions": "node ./typescript/post-process/decisions-dataset.js",
        "batch": "node ./typescript/post-process/batch.js",
        "train-fight": "node ./typescript/post-process/train-fight.js",
        "update-version": "node ./typescript/post-process/update-version.js",
        "update-ne": "npm run build:node && node ./dist/post-process/static-neutrals-matchup.js",
        "neutrals": "npm run build:node && node ./dist/post-process/neutrals.js",
        "matchups": "npm run build:node && node ./dist/post-process/matchups.js",
        "release": "node ./typescript/post-process/update-version.js && npm run build && npm run prettier"
    },
    "dependencies": {
        "cheerio": "^1.1.0",
        "puppeteer": "^24.16.2"
    }
}
